# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Infrastructure (required) ────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/vitale
REDIS_URL=redis://localhost:6379

# ── Auth (required, min 32 chars) ────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-secret-32+chars

# ── CORS (production only, comma-separated) ──────────────────────────
# CORS_ORIGINS=https://app.vitale.dz,https://dashboard.vitale.dz

# ── Swagger basic-auth (required in development) ─────────────────────
SWAGGER_USER=admin
SWAGGER_PASS=changeme

# ── Notifications / SMTP (required) ──────────────────────────────────
# Set false to log emails instead of sending them (the Notification record is
# still created, so the full path is exercised locally).
NOTIFICATIONS_ENABLED=true
#
# Gmail SMTP is DEVELOPMENT ONLY (≈500/day, throttled, lands in spam because a
# personal Gmail has no SPF/DKIM for vitale.dz). Production = Resend/SES/Postmark.
#
# Gmail needs an APP PASSWORD, not your account password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account → Security → App passwords → generate one for "Mail".
#   3. Paste the 16-character value (no spaces) into SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=Vitale
MAIL_FROM_ADDRESS=you@gmail.com

# ── Auth: JWT secrets (required, one per purpose, each ≥ 32 chars) ────
# Generate each with:  openssl rand -base64 48
# Use DIFFERENT values — a token minted for one purpose must fail signature
# verification for every other. Never commit real secrets.
JWT_DOCTOR_ACCESS_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_DOCTOR_REFRESH_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_ADMIN_ACCESS_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_ADMIN_REFRESH_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_EMAIL_VERIFY_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_PASSWORD_RESET_SECRET=replace-me-with-a-long-random-secret-32+chars
JWT_OAUTH_TICKET_SECRET=replace-me-with-a-long-random-secret-32+chars
# Token lifetimes (jsonwebtoken duration strings).
JWT_DOCTOR_ACCESS_TTL=1h
JWT_DOCTOR_REFRESH_TTL=24h

# Base URL of the dashboard — used to build verification / reset links.
APP_URL=http://localhost:5173
# Optional: set to share the auth cookies across subdomains, e.g. .vitale.dz
# COOKIE_DOMAIN=

# ── OAuth (Google) — required only when OAUTH_GOOGLE_ENABLED=true ─────
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console →
# APIs & Services → Credentials. Add the redirect URI below to "Authorized
# redirect URIs". The client secret NEVER leaves the backend.
OAUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/oauth/google/callback
